# ===================== SparkLearn 多智能体系统 环境变量 =====================
# 凡未填写的密钥,系统自动进入 DEMO_MODE(本地模拟流式输出,可离线演示全链路)

# ---- 讯飞星火 OpenAI 兼容 HTTP 接口(控制台 APIPassword,作 Bearer Token)----
SPARK_API_PASSWORD=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1/
SPARK_X2_BASE_URL=https://spark-api-open.xf-yun.com/x2/

# ---- 讯飞 WebSocket/HTTP 旧鉴权三元组(TTS / 文生图 / OCR 需要 HMAC 签名)----
SPARK_APPID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ---- 火山方舟 Seedance 视频生成(可选;缺省自动降级 Manim+TTS 本地方案)----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=

# ---- 存储(全部可缺省:sqlite + 内存向量库,零依赖跑通)----
DATABASE_URL=
MILVUS_URI=
REDIS_URL=

# ---- Embedding: auto | bge-m3 | iflytek | hash ----
EMBEDDING_BACKEND=auto

# ---- 行为开关 ----
DEMO_MODE=auto
TRACE_ENABLED=true
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
