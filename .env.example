# ===================== SparkLearn 多智能体系统环境变量 =====================
# 使用方式:
# 1. 复制本文件为 .env:  cp .env.example .env
# 2. 只把真实密钥填进 .env,不要把 .env 提交到 Git。
# 3. 留空密钥时,DEMO_MODE=auto 会自动进入离线演示模式(MockEngine)。

# ---- 讯飞星火文本大模型(OpenAI 兼容 HTTP,普通档与 X2/reasoner 共用)----
# 来源: 讯飞开放平台控制台 -> 星火认知大模型/HTTP 服务 -> APIPassword。
# 真实模式: 必填。demo 模式: 可留空;留空且 DEMO_MODE=auto 时会走 MockEngine。
# 用途: 作为 Authorization: Bearer <APIPassword> 调用 llm_complete()/llm_stream()。
SPARK_API_PASSWORD=

# 来源: 讯飞星火 HTTP 调用文档给出的 OpenAI 兼容 base_url。
# 真实模式: 一般保留默认值。demo 模式: 可保留默认值。
# 用途: ultra/max/pro/lite 等普通文本模型的 base_url。
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1/

# 来源: 讯飞星火 X 系列/深度推理接口文档或控制台给出的 X2 base_url。
# 真实模式: reasoner/grounding/path 推理需要;一般保留默认值。demo 模式: 可保留默认值。
# 用途: role="reasoner" 时调用 spark-x。
SPARK_X2_BASE_URL=https://spark-api-open.xf-yun.com/x2/

# ---- 讯飞 WebSocket/HTTP 旧鉴权三元组(TTS / 文生图 / OCR)----
# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APPID。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空,对应功能会返回演示结果或安全降级。
SPARK_APPID=

# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APIKey。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空。
# 注意: 这是三元组 APIKey,不是文本大模型的 APIPassword。
SPARK_API_KEY=

# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APISecret。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空。
# 注意: 与 SPARK_API_KEY 配套用于 HMAC 签名。
SPARK_API_SECRET=

# ---- 火山方舟 Seedance 视频生成(可选;缺省自动降级 Manim+TTS 本地方案)----
# 来源: 火山方舟控制台 -> API Key 管理 -> 创建/复制 API Key。
# 真实模式: 要真实调用 Seedance 视频时必填。demo 模式: 可留空。
ARK_API_KEY=

# 来源: 火山方舟 API 文档/控制台给出的 OpenAPI endpoint。
# 真实模式: 一般保留默认值。demo 模式: 可保留默认值。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 来源: 火山方舟控制台 -> 模型列表/视频生成模型 -> Seedance 模型 ID。
# 真实模式: 要真实调用 Seedance 视频时必填。demo 模式: 可留空。
# 示例值以控制台当前可用模型为准,不要凭空填写。
SEEDANCE_MODEL=

# ---- 存储(全部可缺省:本地 SQLite + 内存向量库即可跑通 demo)----
# 来源: 自建 PostgreSQL 或 docker-compose 中的 postgres 服务连接串。
# 真实/容器模式: 建议填写 PostgreSQL。demo/本地模式: 可留空,自动使用 SQLite。
DATABASE_URL=

# 来源: Milvus 服务连接地址,例如 docker compose --profile vector 启动后的服务地址。
# 真实向量库模式: 可填。demo 模式: 可留空,自动使用内存/JSON 向量库。
MILVUS_URI=

# 来源: Redis 服务连接地址,例如 docker-compose 中的 redis。
# 真实/容器模式: 可填。demo 模式: 当前主链路可留空。
REDIS_URL=

# ---- Embedding / Reranker ----
# 来源: 本项目配置项。可选值: auto | bge-m3 | iflytek | hash。
# 真实模式: 如需指定真实/本地向量化后端可改。demo 模式: 建议 auto。
EMBEDDING_BACKEND=auto

# 来源: 可选重排服务的 HTTP 地址。
# 真实模式: 接入重排服务时填写。demo 模式: 可留空,保持向量检索原排序。
RERANK_API_URL=

# 来源: 可选重排服务的 API Key。
# 真实模式: 接入需要鉴权的重排服务时填写。demo 模式: 可留空。
RERANK_API_KEY=

# 来源: 本项目配置项。
# 真实/demo 模式: 可保留默认值;表示重排取前多少条候选。
RERANK_TOP_K=5

# ---- 行为开关 ----
# 来源: 本项目配置项。可选值: auto | true | false。
# auto: SPARK_API_PASSWORD 为空则 demo,非空则真实。
# true: 强制 demo,即使填了 SPARK_API_PASSWORD 也走 MockEngine。
# false: 强制真实,即使没填 SPARK_API_PASSWORD 也会尝试真实调用并可能失败。
DEMO_MODE=auto

# 来源: 本项目配置项。
# 真实/demo 模式: 建议 true;会写 backend/runs/{session_id} 调试包。
TRACE_ENABLED=true

# 来源: 本项目配置项。
# 本地后端端口;真实/demo 模式均可保留默认值。
BACKEND_PORT=8000

# 来源: 本项目配置项。
# 后端 CORS 允许的前端地址;本地开发默认 http://localhost:3000。
FRONTEND_ORIGIN=http://localhost:3000

# 来源: 前端运行时配置。
# 本地开发填 http://localhost:8000;docker 内部可由 compose 覆盖为 http://backend:8000。
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
